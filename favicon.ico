<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" height="100%">
    <!-- Outer Cyber Hexagon Base -->
    <polygon points="50,5 90,27.5 90,72.5 50,95 10,72.5 10,27.5" 
             fill="#0a0e27" 
             stroke="#00d4ff" 
             stroke-width="4" 
             stroke-linejoin="round"/>
    
    <!-- Inner Cyber Circuit Nodes -->
    <circle cx="50" cy="5" r="3" fill="#00ff88"/>
    <circle cx="90" cy="27.5" r="3" fill="#00ff88"/>
    <circle cx="90" cy="72.5" r="3" fill="#00ff88"/>
    <circle cx="50" cy="95" r="3" fill="#00ff88"/>
    <circle cx="10" cy="72.5" r="3" fill="#00ff88"/>
    <circle cx="10" cy="27.5" r="3" fill="#00ff88"/>

    <!-- Maritime Anchor Core -->
    <!-- Top Ring -->
    <circle cx="50" cy="24" r="5" fill="none" stroke="#00d4ff" stroke-width="3"/>
    
    <!-- Main Vertical Shaft -->
    <line x1="50" y1="29" x2="50" y2="72" stroke="#00d4ff" stroke-width="4" stroke-linecap="round"/>
    
    <!-- Crossbar -->
    <line x1="38" y1="38" x2="62" y2="38" stroke="#00d4ff" stroke-width="4" stroke-linecap="round"/>
    
    <!-- Bottom Curved Flukes -->
    <path d="M 28,58 C 28,78 72,78 72,58" fill="none" stroke="#00d4ff" stroke-width="4" stroke-linecap="round"/>
    
    <!-- Arrowhead Tips -->
    <polygon points="28,52 23,60 33,60" fill="#00ff88"/>
    <polygon points="72,52 67,60 77,60" fill="#00ff88"/>
    
    <!-- Central Node Glowing Core -->
    <circle cx="50" cy="50" r="4" fill="#00ff88"/>
</svg>
